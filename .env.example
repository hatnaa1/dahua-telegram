# Never commit .env. Existing environment variables override this file in the CLI.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=-1003974950304
DEVICE_NAME=Dahua DH-IPC-HDBW1230E-S5
# Firmware 2.800 requires non-empty camera SMTP credentials and Anonymous=false.
SMTP_USER=dahua
SMTP_PASS=dahua123
WEBHOOK_TOKEN=
COOLDOWN_S=15
SMTP_BIND=0.0.0.0
HTTP_BIND=0.0.0.0
SMTP_PORT=2525
HTTP_PORT=8090

DAHUA_IP=192.168.1.50
DAHUA_USER=admin
DAHUA_PASSWORD=
# DAHUA_PASS is accepted as a fallback when DAHUA_PASSWORD is empty.
DAHUA_PASS=
DAHUA_SMTP_SERVER=192.168.1.245
DAHUA_SMTP_PORT=25
DAHUA_SENDER=dahua-front@camera.local
DAHUA_RECEIVER=alerts@camera.local
DAHUA_TITLE=Dahua Front Door
DAHUA_MOTION_LEVEL=3

# Optional camera-only overrides; otherwise SMTP_USER/SMTP_PASS, then dahua/dahua123.
# If bridge authentication is enabled these must match the bridge credentials.
DAHUA_SMTP_USER=
DAHUA_SMTP_PASS=
